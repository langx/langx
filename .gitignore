node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# secrets — never commit; see .env.example
.env
.env.*
# any `<name>.env` too (e.g. an Atlas credentials download), which `.env.*`
# does not match.
*.env
!.env.example
# Signing keys, which arrive as a download with a name nobody chooses:
# Apple's Sign in with Apple and APNs keys are `AuthKey_XXXXXXXXXX.p8` and
# land in whatever directory the browser was pointed at. One of them sat
# untracked in this repo's root on 3 September 2026 — a public repo, one
# `git add -A` away from publishing the private half of an Apple credential.
*.p8
*.pem
*.key
*.keystore
*.jks

# expo
.expo/
.expo-shared/
web-build/
expo-env.d.ts
apps/mobile/ios/
apps/mobile/android/

# os / editor
.DS_Store
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json

# Signing keys. `apps/mobile/android/` is ignored already, but a keystore
# copied anywhere else in a public repo is a lost app, not a lost file: Play
# will not accept an update signed by a different key.
*.keystore
*.jks

# FCM Android client config. Not a secret in the usual sense, but it is
# instance-specific and this repo is public — point GOOGLE_SERVICES_JSON at it.
google-services.json
GoogleService-Info.plist

# screenshots written by the tools/ext-lab scripts
tools/ext-lab/shots/
