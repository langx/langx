node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# secrets — never commit; see .env.example
.env
.env.*
# any `<name>.env` too (e.g. an Atlas credentials download), which `.env.*`
# does not match.
*.env
!.env.example
# Signing keys, which arrive as a download with a name nobody chooses:
# Apple's Sign in with Apple and APNs keys are `AuthKey_XXXXXXXXXX.p8` and
# land in whatever directory the browser was pointed at. One of them sat
# untracked in this repo's root on 3 September 2026 — a public repo, one
# `git add -A` away from publishing the private half of an Apple credential.
*.p8
*.pem
*.key
*.keystore
*.jks

# expo
.expo/
# Running `expo` or `eas` from the workspace root instead of apps/mobile writes
# an empty `{ "expo": {} }` here. The real config is apps/mobile/app.config.ts.
/app.json
.expo-shared/
web-build/
expo-env.d.ts
apps/mobile/ios/
apps/mobile/android/

# Other sessions' worktrees, which live inside this checkout and are each a
# full copy of it — 48 GB of them on the machine this was written on.
#
# Git already skips them here through `.git/info/exclude`, which is local and
# uncommitted, so this line looks redundant and is not. EAS reads `.gitignore`
# and does not read `info/exclude`: building from this checkout put every
# worktree's `apps/mobile/ios/` into the upload, because those patterns are
# root-anchored and match nothing under `.claude/`. The archive went from 14 MB
# to 809 MB and took 23 minutes instead of 51 seconds, on 20 September 2026.
#
# Not an `.easignore`, which would have been the obvious place: EAS uses that
# file *instead of* `.gitignore`, so it would need a copy of everything here —
# including the `.env` rules. A drifting copy of those uploads a secret.
.claude/worktrees/

# os / editor
.DS_Store
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json

# Signing keys. `apps/mobile/android/` is ignored already, but a keystore
# copied anywhere else in a public repo is a lost app, not a lost file: Play
# will not accept an update signed by a different key.
*.keystore
*.jks

# FCM Android client config. Not a secret in the usual sense, but it is
# instance-specific and this repo is public — point GOOGLE_SERVICES_JSON at it.
google-services.json
GoogleService-Info.plist

# screenshots written by the tools/ext-lab scripts
tools/ext-lab/shots/

# Recordings, frames and the finished mp4 — see tools/promo-video/README.md.
# The cut files belong in the branding checkout, not in a public git history.
tools/promo-video/out/

# Assembled from the branding checkout by collect-store-screenshots.mjs and
# collect-play-screenshots.mjs; the images themselves live in langx/branding,
# not here.
apps/mobile/fastlane/screenshots/
apps/mobile/fastlane/metadata/
apps/mobile/fastlane/README.md
apps/mobile/fastlane/report.xml

# Rendered cue pictures — see tools/echo-content/images/build.mjs.
tools/echo-content/images/out/

# Generated by @bacons/apple-targets from each target's `colors` and `images`,
# on every `expo prebuild`. The PNG in here is a copy of one already in
# `assets/`; committing it would be the same picture twice, free to drift.
apps/mobile/targets/**/Assets.xcassets/
