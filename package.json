{
  "name": "langx",
  "version": "2.1",
  "private": true,
  "description": "LangX v2 \u2014 language exchange app (Expo mobile/web + Fastify API + MongoDB Atlas)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/langx/langx"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @langx/api run dev",
    "dev:mobile": "pnpm --filter @langx/mobile run dev",
    "dev:web": "pnpm --filter @langx/mobile run web",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "overrides": {
      "fflate": "0.7.5",
      "decode-uri-component": "^0.5.0",
      "uuid": "^11.1.1"
    }
  }
}
