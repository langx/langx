{
  "name": "langx",
  "version": "3.1",
  "private": true,
  "description": "LangX v2 \u2014 language exchange app (Expo mobile/web + Fastify API + MongoDB Atlas)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/langx/langx"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @langx/api run dev",
    "dev:mobile": "pnpm --filter @langx/mobile run dev",
    "dev:web": "pnpm --filter @langx/mobile run web",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "insight": "node --env-file-if-exists=.env scripts/insight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "fflate": "0.7.5",
      "decode-uri-component": "^0.5.0",
      "uuid": "^11.1.1",
      "js-yaml": "^4.3.2",
      "@expo/plist>@xmldom/xmldom": "^0.8.15",
      "fast-uri@>=4.0.0 <4.1.5": "^4.1.5",
      "ip-address@<10.7.1": "^10.7.1",
      "engine.io@>=6.6.0 <6.6.10": "^6.6.10"
    },
    "patchedDependencies": {
      "expo-media-library@57.0.5": "patches/expo-media-library@57.0.5.patch"
    }
  }
}
