# LangX v2 — environment template
#
# This repository is public (BSD-3). NO REAL VALUE EVER GOES IN A COMMITTED FILE.
# Copy to `.env` (git-ignored) for local dev; use the platform secret store in
# staging/production. Anything prefixed EXPO_PUBLIC_ is compiled into the client
# bundle and is world-readable by design — never put a secret behind that prefix.

# ─── API: runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── API: database ───────────────────────────────────────────────────────────
# Atlas SRV string, or `mongodb://127.0.0.1:27017` for a local mongod.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=langx_dev

# ─── API: auth (Faz 1) ───────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional — defaults to http://<HOST>:<PORT> when unset.
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated origins allowed to send credentialed requests.
# Shared with the Cloudflare transform rule that stamps every request coming
# through the edge. Without it the API cannot tell a real CF-IPCountry header
# from one somebody sent straight to the origin's IP, and it stops believing
# either — onboarding then asks for the country instead of reading it.
EDGE_SECRET=
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Create it as a **Web application** client, even for the phone: the app never
# talks to Google, it opens a browser at this API and the API does the
# exchange. Separate iOS/Android OAuth clients are not needed and do not work
# here. The browser returns to the app through the `langx://` scheme, which is
# why both schemes are in TRUSTED_ORIGINS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer → Certificates, Identifiers & Profiles.
# APPLE_CLIENT_ID is the Services ID (not the app's bundle ID).
# Redirect URI in the Services ID config: {BETTER_AUTH_URL}/api/auth/callback/apple
# — Apple only allows HTTPS redirect URIs, so this cannot be tested against a
# plain http://localhost URL; it needs a real deploy or an HTTPS tunnel.
# APPLE_PRIVATE_KEY is the .p8 from a Sign in with Apple key, PEM content with
# real newlines replaced by literal \n (see auth/appleClientSecret.ts).
# The Services ID is still what Android and web use. On iOS the app shows
# Apple's own sheet instead, which returns a token issued to the *bundle*
# identifier — accepted because auth.ts declares appBundleIdentifier. Both
# routes land on the same account; no extra variable is involved.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Apple will not save the Services ID's return URL until it has fetched a file
# it generates from the *return URL's own host* — this API, not the web app:
#   https://<api host>/.well-known/apple-developer-domain-association.txt
# Paste that file's contents here and the API serves them at that path. Public,
# not secret. Unset, the path 404s and the Services ID cannot be configured.
APPLE_DOMAIN_ASSOCIATION=

# ─── API: email (Faz 1) ──────────────────────────────────────────────────────
# Without a key, verification/reset emails are logged instead of sent — the
# app still boots and auth is fully testable locally.
RESEND_API_KEY=
# resend.dev needs no domain verification, so this works immediately. Point
# it at a verified langx.io sender before Faz 13's launch.
EMAIL_FROM=LangX <onboarding@resend.dev>

# ─── API: storage (Faz 2 / 11) ───────────────────────────────────────────────
# S3-compatible; the published app runs on Backblaze B2 (same account as v1,
# bucket `langx-media`, region eu-central-003). R2 runs on the same code path.
# For B2 the region is the middle of the S3 endpoint host, and the public base
# URL is `https://f00N.backblazeb2.com/file/<bucket>` unless a CDN sits in
# front. STORAGE_PUBLIC_BASE_URL becomes part of every stored URL — pick it
# once, before any real upload or the migration ETLs. docs/self-host.md → Storage.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# ─── API: translation (Faz 6) ────────────────────────────────────────────────
# Google Cloud Console → a project with the Cloud Translation API enabled →
# IAM & Admin → Service Accounts → create one with the "Cloud Translation
# API User" role → Keys → Add key (JSON) → paste the whole file's content
# below on one line (escape newlines in private_key as \n, same as
# APPLE_PRIVATE_KEY). Left unset, /translate fails clearly; nothing else
# depends on it.
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_TRANSLATE_SERVICE_ACCOUNT_JSON=

# ─── API: billing (Faz 7) ────────────────────────────────────────────────────
# RevenueCat dashboard → API Keys → Secret API key. Used by POST /billing/refresh
# to reconcile straight from RevenueCat when a webhook is late or lost.
REVENUECAT_SECRET_API_KEY=
# RevenueCat dashboard → your webhook's "Authorization header value" — a
# shared secret you pick yourself, not a value RevenueCat generates. Left
# unset, POST /webhooks/revenuecat refuses every request (fails closed).
REVENUECAT_WEBHOOK_AUTH_HEADER=
# `true` swaps RevenueCat for an in-process fake and exposes
# POST /billing/test-event, so a purchase can be driven end to end with no
# store product and no network — see docs/billing-testing.md. Takes precedence
# over REVENUECAT_SECRET_API_KEY above, and the API refuses to boot with it set
# under NODE_ENV=production. Leave blank unless you are testing billing.
REVENUECAT_FAKE_STORE=
# Not read by this backend at all — RevenueCat Web's Stripe connection is a
# one-time dashboard configuration on RevenueCat's side, not a runtime API
# call from here. Kept as a placeholder for that account's own bookkeeping.
STRIPE_SECRET_KEY=

# ─── API: observability ──────────────────────────────────────────────────────
SENTRY_DSN=

# ─── API: migration (Faz 2 / 11) ─────────────────────────────────────────────
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Salt for hashing legacy emails into handleReservations.legacyEmailHash.
LEGACY_EMAIL_HASH_SALT=

# Only needed if the Expo project has enhanced push security switched on, in
# which case unauthenticated sends are rejected. Expo dashboard → Access
# tokens. Normally left blank.
EXPO_ACCESS_TOKEN=

# ─── Mobile/web client (public — shipped in the bundle) ──────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
# Path to the Firebase Android config for FCM. Gitignored (this repo is
# public), and app.config.ts leaves googleServicesFile unset without it — the
# build succeeds and Android simply receives no remote notifications.
GOOGLE_SERVICES_JSON=
# RevenueCat dashboard → API keys → SDK API keys. Public by design: these
# identify the app and are compiled into the bundle. The secret key belongs to
# REVENUECAT_SECRET_API_KEY above and must never appear under this prefix.
#
# The per-platform pair is what a released build uses, and each needs a real
# App Store / Play configuration in RevenueCat to exist at all. Until then the
# project has only a Test Store app, whose single key covers both platforms —
# set that one and leave the pair blank. With none of them set, the paywall
# renders and says purchasing is unavailable; nothing else in the app changes.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=
# `1` is the client half of REVENUECAT_FAKE_STORE: the paywall lists every
# package at obviously fake prices and buying one calls the API's fake store.
# Ignored unless the bundle is a development one, so it cannot follow a web
# export into production. Both halves have to be set for a purchase to land.
EXPO_PUBLIC_REVENUECAT_FAKE_STORE=

# `1` draws the on-screen debug panels (today: the profile's daily quota
# counters). Ignored unless the bundle is a development one, for the same
# reason as the flag above.
EXPO_PUBLIC_DEBUG_PANEL=
EXPO_PUBLIC_SENTRY_DSN=
