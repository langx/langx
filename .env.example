# LangX v2 — environment template
#
# This repository is public (BSD-3). NO REAL VALUE EVER GOES IN A COMMITTED FILE.
# Copy to `.env` (git-ignored) for local dev; use the platform secret store in
# staging/production. Anything prefixed EXPO_PUBLIC_ is compiled into the client
# bundle and is world-readable by design — never put a secret behind that prefix.

# ─── API: runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── API: database ───────────────────────────────────────────────────────────
# Atlas SRV string, or `mongodb://127.0.0.1:27017` for a local mongod.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=langx_dev

# ─── API: auth (Faz 1) ───────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated origins allowed to send credentialed requests.
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── API: email (Faz 1) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=LangX <no-reply@langx.io>

# ─── API: storage (Faz 2 / 11) ───────────────────────────────────────────────
# S3-compatible; R2 is the target, B2 is the fallback — same code path.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# ─── API: translation (Faz 6) ────────────────────────────────────────────────
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
DEEPL_API_KEY=

# ─── API: billing (Faz 7) ────────────────────────────────────────────────────
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=
STRIPE_SECRET_KEY=

# ─── API: observability ──────────────────────────────────────────────────────
SENTRY_DSN=

# ─── API: migration (Faz 2 / 11) ─────────────────────────────────────────────
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Salt for hashing legacy emails into handleReservations.legacyEmailHash.
LEGACY_EMAIL_HASH_SALT=

# ─── Mobile/web client (public — shipped in the bundle) ──────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
EXPO_PUBLIC_SENTRY_DSN=
