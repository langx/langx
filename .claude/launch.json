{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "langx-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@langx/api", "dev"],
      "port": 4000
    },
    {
      "name": "langx-mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/mobile", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../website", "run", "dev"],
      "port": 5173
    },
    {
      "name": "langx-api-4100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@langx/api", "dev"],
      "port": 4100
    },
    {
      "name": "langx-mobile-native",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/mobile", "exec", "expo", "start", "--port", "8082"],
      "port": 8082
    }
  ]
}
