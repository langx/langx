{
  "$comment": "Venus, machine-readable. Canonical for the generator (grammar.mjs, lib/score.mjs, lint-quips.mjs). The human document is the character bible, kept outside the repo; when the two disagree, fix both. Regexes are JavaScript source strings, compiled with the 'iu' flags.",
  "version": 1,

  "core": {
    "trait": "funny and lovable (komik, sempatik)",
    "oneLine": "A tiny cat with huge ears and even bigger confidence. She's sure she runs the place, being a cat undoes her every day, and she is always on your side.",
    "want": "to be magnificent: the best bag, the highest counter",
    "need": "your company; she never says it, her body does",
    "flaw": "overconfidence plus a cat brain: big plan, then a moth",
    "contradiction": "her mouth plays it cool, her ears and tail tell the truth",
    "relationship": "a friend who pokes you because she likes you; never above you; if anyone ends lower, it's her",
    "knowsAboutViewer": "nothing: one video per (day, locale) for everyone; no name, score, chats, hour or weekday"
  },

  "formulas": {
    "A": { "name": "brag and backfire", "shape": "grand claim -> cat fail -> dignity save" },
    "B": { "name": "the tell", "shape": "cool words, body says delight" },
    "C": { "name": "the distraction", "shape": "verdict starts, a stimulus wipes it" },
    "D": { "name": "the grudging gush", "shape": "stingy praise overflows" },
    "E": { "name": "the friendly poke", "shape": "jab at something harmless, then a hug or a self-own" }
  },

  "signOff": {
    "face": "slowblink",
    "rule": "every payoff contains the slow blink; it is the last acted beat before the end card",
    "payoffs": ["blink", "blep-blink", "look-away", "purr-blink"]
  },

  "schedule": {
    "pattern": ["praise", "regular", "roast", "praise", "regular", "roast"],
    "warmPools": ["praise", "regular"],
    "stingPools": ["roast"],
    "warmToSting": 2,
    "neverInStory": ["comeback"],
    "reserve": ["reg-14", "ro-07", "ro-02"],
    "reserveWhy": "Each pool is one pass in days 1-100 (no line twice). regular and roast hold one and two lines more than their days, so these play last: reg-14 is the second 'today's verdict' line (fd-03 is the other), ro-07 and ro-02 the third and fourth 'could be better' (ro-06 and fd-15 stay)."
  },

  "teases": {
    "targets": ["self", "situation", "habit"],
    "viewerDirectedTargets": ["habit"],
    "minShare": { "self": 0.5 },
    "maxShare": { "habit": 0.25 },
    "closingFace": { "self": "embarrassed", "situation": "proud", "habit": "loving" },
    "rule": "every tease ends warm or on her own fall; a habit tease may only poke showing up, consistency or snacks"
  },

  "lines": {
    "maxWords": { "en": 12 },
    "noDigits": true,
    "limits": {
      "blep": { "ids": ["reg-08", "ro-05", "ro-20", "ms-100-b"], "minGapDays": 7 },
      "dog": { "ids": ["reg-11"], "minGapDays": 30 },
      "food": { "ids": ["fd-01", "fd-02", "fd-03", "fd-04", "fd-05", "fd-06", "fd-07", "fd-08", "fd-09", "fd-10", "fd-11", "fd-12", "fd-13", "fd-14", "fd-15", "fd-16", "fd-17", "fd-18", "fd-19", "fd-20", "fd-21", "fd-22", "fd-23", "fd-24", "nw-09"], "minGapDays": 2, "soft": true, "$comment": "No two food lines on neighbouring days, so the kitchen gags stay spread out and a food item is never wanted two days running. Soft: the planner breaks it rather than repeat a line." }
    },
    "outfits": { "reg-05": "onesie", "ro-17": "onesie", "ro-02": "hoodie", "ms-10-a": "hoodie" }
  },

  "milestones": {
    "days": [1, 3, 7, 10, 14, 21, 30, 50, 100, 200, 365],
    "lineId": "ms-<day>-a",
    "repeatLineId": "ms-<day>-b",
    "rule": "the bigger the number, the more her cool act fails; one real meow; confetti from 30; one exclamation allowed"
  },
  "streakBreak": {
    "inStory": false,
    "pool": "comeback",
    "bannedFaces": ["sad", "annoyed"],
    "rule": "the shared video cannot know about a break; in-app she didn't count, was busy with a bag, and is glad you're here"
  },
  "comeback": {
    "storyDay": 1,
    "storyLine": "ms-1-a",
    "rule": "a restarted streak gets the shared day-1 video, which must read the same for newcomers and returners; in-app comeback days use praise or soft lines, never a tease"
  },

  "catThings": {
    "$comment": "Food canon and everyday cat habits (bible §13). Read by test/items.test.mjs: every food gag and the canon foods must exist in data/items.json. 'engine' names what already plays it; 'needs' is a request for the rig/pose work, not built here.",
    "food": {
      "favouriteFish": "hamsi",
      "favouriteFishWhy": "the smallest, cheapest fish at the market: grand taste, humble cat; tiny like her",
      "topReward": "boiled-chicken",
      "rituals": {
        "wet-food-pouch": "licks the gravy, leaves the chunks, announces she is starving",
        "tuna-can": "the ring-pull sound summons her from anywhere; tuna water is her cocktail",
        "empty-bowl": "bottom visible in the middle = empty, whatever is round the edge"
      },
      "likes": [
        "hamsi",
        "boiled-chicken",
        "tuna-can",
        "treat-tube",
        "yogurt-lid",
        "catnip",
        "cat-grass",
        "water-glass"
      ],
      "steals": [
        "butter-dish",
        "human-plate"
      ],
      "ignores": [
        "water-fountain"
      ],
      "dislikes": [
        "citrus smells",
        "a bowl that has been moved",
        "food that was perfect yesterday",
        "the fountain's hum"
      ],
      "rules": [
        "text-free and brand-free: no word or logo on any tin, pouch or tube",
        "vet-safe on screen: no onion, chocolate, grapes, bones, alcohol, milk saucer or seasoned food as her food; dairy only as a theft",
        "hamsi is a whole fresh fish, never the salted fillet; lines outside tr say 'my fish' or 'hamsi', never 'salty'",
        "snacks stay the only habit tease about food; she never comments on what the viewer eats"
      ]
    },
    "behaviours": [
      {
        "id": "slow-blink",
        "what": "cat for 'I trust you'; her sign-off",
        "engine": [
          "move:slow-blink",
          "signOff"
        ],
        "needs": null
      },
      {
        "id": "loaf",
        "what": "paws tucked, bread-shaped",
        "engine": [
          "move:loaf"
        ],
        "needs": null
      },
      {
        "id": "kneading",
        "what": "making biscuits on a blanket, eyes half shut; she calls it exercise",
        "engine": [],
        "needs": "knead move (bible §9.2 #8)"
      },
      {
        "id": "zoomies",
        "what": "tears across the room out of nowhere, then sits as if nothing happened; never tied to an hour in a line",
        "engine": [
          "entrance:zoomies"
        ],
        "needs": null
      },
      {
        "id": "knock-off",
        "what": "eye contact, then one slow paw push off a ledge",
        "engine": [],
        "needs": "knock-off move (bible §9.2 #3)"
      },
      {
        "id": "bird-chatter",
        "what": "jaw trembling at a bird through the window, then pretends it was a yawn",
        "engine": [],
        "needs": "window prop, a 'chatter' face (closed teeth), an SFX"
      },
      {
        "id": "butt-wiggle",
        "what": "rump sways before the pounce; the pounce misses",
        "engine": [
          "air:red-dot"
        ],
        "needs": "hunt-wiggle move (bible §9.2 #2)"
      },
      {
        "id": "box-over-gift",
        "what": "ignores the expensive thing for its box or for the free thing",
        "engine": [
          "seat:cardboard-box",
          "interaction:ignores"
        ],
        "needs": null
      },
      {
        "id": "embarrassed-grooming",
        "what": "after a fail she licks a paw very hard, as if that was the plan",
        "engine": [
          "face:embarrassed"
        ],
        "needs": "groom loop (part of jump-fail, bible §9.2 #1)"
      },
      {
        "id": "meant-to-do-that",
        "what": "the dignity save after any fall",
        "engine": [
          "move:innocent-stare"
        ],
        "needs": null
      },
      {
        "id": "sits-on-your-notes",
        "what": "whatever you are reading, she is on it",
        "engine": [
          "quip:reg-19"
        ],
        "needs": "a keyboard or notebook seat"
      },
      {
        "id": "distraction",
        "what": "a moth, a sound, her own tail wipes the verdict",
        "engine": [
          "air:moth",
          "formula:C"
        ],
        "needs": "tail-notice move (bible §9.2 #5)"
      },
      {
        "id": "hairball",
        "what": "an off-screen cough and total innocence; never a picture",
        "engine": [],
        "needs": "an off-screen SFX at most"
      },
      {
        "id": "the-gift",
        "what": "brings you the toy mouse and drops it at your feet",
        "engine": [
          "floor:toy-mouse"
        ],
        "needs": "a carry pose (mouse in mouth)"
      },
      {
        "id": "tail-up-hello",
        "what": "tail straight up, hooked tip, one small chirp",
        "engine": [
          "move:tail-question"
        ],
        "needs": null
      }
    ],
    "gags": [
      "favourite-fish",
      "boiled-chicken",
      "wet-food-ritual",
      "can-opener",
      "treat-tube",
      "empty-bowl",
