  "lint": {
    "$comment": "Categories the lint rejects in every quip. 'all' applies to every locale. Scope 'line' = whole text; scope 'habit' = only teases aimed at the viewer (target habit).",
    "allow": {
      "ms-7-a": { "categories": ["number"], "why": "Owner-approved 25 Oct: 'Seven days. My longest relationship was with a cardboard box. Three days.' The count is the joke, so this one line says it out loud; every other line stays number-free." }
    },
    "categories": {
      "number": {
        "why": "the day number is on screen; lines are number-free (one and two, once and twice, are allowed: they name luck, chance and double digits, not the count)",
