        "en": ["(?<!high[ -])\\bfive\\b", "\\b(three|four|six|seven|eight|nine|eleven|twelve|thirteen|fifteen|twenty|thirty|forty|fifty|hundred|thousand)\\b"],
        "tr": ["(^|[^\\p{L}])(üç|dört|beş|yedi|sekiz|dokuz|yirmi|otuz|kırk|elli|yüzüncü)([^\\p{L}]|$)"],
