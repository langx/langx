{
  "name": "@langx/mobile",
  "version": "2.7.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "LangX v2 client — iOS, Android and web from one Expo codebase",
  "main": "./index.ts",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear && cp dist/+not-found.html dist/404.html",
    "deploy:web": "npx wrangler pages deploy dist --project-name langx-web --branch main && node scripts/verify-web-deploy.mjs",
    "verify:web": "node scripts/verify-web-deploy.mjs",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "gen:strings": "tsx scripts/generate-xcstrings.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run"
  },
  "dependencies": {
