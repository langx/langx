{
  "name": "@langx/mobile",
  "version": "2.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "LangX v2 client \u2014 iOS, Android and web from one Expo codebase",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear && cp dist/+not-found.html dist/404.html",
    "deploy:web": "npx wrangler pages deploy dist --project-name langx-web --branch main",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@langx/shared": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "expo": "~57.0.20",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
