# The binary goes up through EAS, never from here.
skip_binary_upload(true)

# Metadata does go up, and it has to: App Store Connect will not take a
# screenshot for a locale that does not exist yet, and a locale is created by
# giving it a description and keywords. Only the locales with a folder under
# fastlane/metadata are touched — English has none, so the copy already on the
# version is left exactly as it is.
skip_metadata(false)

# Replace the whole set rather than adding to it. Without this, deliver leaves
# whatever is already in a slot alone, and a slot that is already full silently
# keeps the old shots. Replacing is also what fixes the order: App Store
# Connect keeps a bulk upload in whatever sequence it finished processing,
# while deliver uploads one at a time in filename order — which is why
# collect-store-screenshots.mjs numbers them 6.9-01 … 6.9-08.
overwrite_screenshots(true)

# Written by the two collect-store-* scripts in ../scripts.
screenshots_path('./fastlane/screenshots')
metadata_path('./fastlane/metadata')
