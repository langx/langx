    "widget.todayDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Streak, unread and cards due, in one row."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seri, okunmamışlar ve sıradaki kartlar tek sırada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha, no leídos y tarjetas pendientes, en una fila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия, непрочитанные и карточки — в один ряд."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلسلة وغير المقروء والبطاقات المستحقة في صف واحد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Série, non lus et cartes à revoir, sur une ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie, Ungelesenes und fällige Karten in einer Reihe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequência, não lidas e cartões do dia, lado a lado."
          }
        }
      }
    },
