    "widget.streakDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your run of days. Dim until today counts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst üste günlerin. Bugün sayılana kadar soluk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus días seguidos. Atenuada hasta que hoy cuente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни подряд. Тускнеет, пока сегодня не засчитано."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيامك المتتالية. باهتة حتى يُحتسب اليوم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos jours d’affilée. Pâle tant qu’aujourd’hui ne compte pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tage in Folge. Blass, bis heute zählt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dias seguidos. Apagada até hoje contar."
          }
        }
      }
    },
